# Точечный замер мест (окна полночь / перед отправлением / открытие продаж).
# Установка — deploy/install-seats.sh, описание — README «Точечный замер на Hetzner».
[Unit]
Description=tabloda.uz: точечный замер мест
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=tabloda-seats
WorkingDirectory=/opt/tabloda-seats
ExecStart=/usr/bin/python3 -u /opt/tabloda-seats/seats_windows.py
Restart=on-failure
RestartSec=60
# 3 — источник ответил 403/429: похоже на блокировку, не перезапускать
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
